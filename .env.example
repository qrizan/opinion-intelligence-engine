# Environment Variables untuk Opinion Intelligence Engine
# Copy file ini menjadi .env dan sesuaikan nilai jika diperlukan

# Port untuk server (default: 8000)
PORT=8000

# CORS allowed origins (pisahkan dengan koma jika lebih dari satu)
# Default: http://localhost:8000,http://127.0.0.1:8000
# Untuk production, set ke domain Anda: https://your-domain.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Google Drive Folder IDs - WAJIB untuk download model
# Uncomment dan isi dengan folder IDs Anda:
# SENTIMENT_FOLDER_ID=your-sentiment-folder-id-here
# SUMMARIZATION_FOLDER_ID=your-summarization-folder-id-here
